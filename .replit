language = "php"
modules = ["php-8.4"]

entrypoint = "index.php"
run = "php -S 0.0.0.0:8080 -t ."

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["php", "-S", "0.0.0.0:8080", "-t", "."]

[[ports]]
localPort = 8080
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:8080 -t ."
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"
